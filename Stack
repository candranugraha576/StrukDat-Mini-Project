#include <stdio.h>
#define MAX 5

typedef struct {
    int data[MAX];
    int top;
} Stack;

void init(Stack *s) {
    s->top = -1;
}

void push(Stack *s, int value) {
    if (s->top == MAX - 1) {
        printf("Stack Overflow\n");
    } else {
        s->data[++(s->top)] = value;
        printf("Added plate %d\n", value);
    }
}

void pop(Stack *s) {
    if (s->top == -1) {
        printf("No plates left\n");
    } else {
        printf("Removed plate %d\n", s->data[(s->top)--]);
    }
}

void display(Stack *s) {
    printf("Stack:\n");
    for (int i = s->top; i >= 0; i--) {
        printf("%d\n", s->data[i]);
    }
}

int main() {
    Stack s;
    init(&s);

    push(&s, 1);
    push(&s, 2);
    push(&s, 3);
    display(&s);

    pop(&s);
    display(&s);
}
